# Root-owned settings read only by /usr/local/sbin/atoma-deploy.
ATOMA_DEPLOY_ROOT=/home/atoma
ATOMA_DEPLOY_REQUIRED_MOUNT=/home/atoma
ATOMA_DEPLOY_SERVICE=atoma.service
ATOMA_DEPLOY_USER=atoma
ATOMA_DEPLOY_APP_ENV=/home/atoma/config/atoma.env
ATOMA_DEPLOY_HEALTH_URL=http://127.0.0.1:4111/
# The mender's own clone and env; absent on a host without a mender.
ATOMA_DEPLOY_MENDER_SERVICE=atoma-mender.service
ATOMA_DEPLOY_MENDER_CHECKOUT=/home/atoma/mender
ATOMA_DEPLOY_MENDER_ENV=/home/atoma/config/mender.env
