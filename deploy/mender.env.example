# Keep separate from atoma.env: no product/OAuth/provider credentials needed.
# HOME must match atoma.service's account HOME, so the machine run lease is shared.
HOME=/home/atoma/state
PATH=/home/atoma/state/.local/bin:/usr/local/bin:/usr/bin:/bin
ATOMA_DB_PATH=/home/atoma/state/atoma.db
ATOMA_RUNS_DIR=/home/atoma/state/runs
ATOMA_SUPERVISOR_DIR=/home/atoma/state/supervisor
ATOMA_MENDER_MODEL=sub:openai:gpt-5.6-sol
ATOMA_MENDER_CODEX_HOME=/home/atoma/state/codex/mender
ATOMA_MENDER_CMD_CODEX=/home/atoma/state/.local/bin/codex
ATOMA_MENDER_SANDBOX_IMAGE=atoma-mender:local
# Contents and Pull requests read/write on mgtf/atoma; no Secrets permission.
GH_TOKEN=REPLACE_WITH_PUBLISHER_TOKEN
# gh supplies Git HTTPS authentication without embedding a token in the remote.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=credential.helper
GIT_CONFIG_VALUE_0="!/usr/bin/gh auth git-credential"
