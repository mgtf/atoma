# Private file, mode 0600. Compose reads raw values: do not wrap them in quotes.
# Configure your registered OAuth application (callback https://<public-host>/auth/callback).
ATOMA_AUTH_GITHUB_CLIENT_ID=
ATOMA_AUTH_GITHUB_CLIENT_SECRET=
# Generate once with openssl rand -hex 32; escrow separately from data backups.
ATOMA_SECRET_ENCRYPTION_KEY=
# API-only reference image. Choose actual supported api:<vendor>:<model> selectors
# in Settings, or set ATOMA_MODEL_L1/L2/L3 here. Organisations supply their own keys.
# Optional host API keys and GitHub App configuration follow .env.example.
