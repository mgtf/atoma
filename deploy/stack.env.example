# Copy outside the repository; fill real published repository@sha256:<64 hex> refs.
# No digest below is fabricated, and unset refs deliberately prevent startup.
ATOMA_WEB_IMAGE=
ATOMA_LAUNCHER_IMAGE=
ATOMA_WORKER_IMAGE=
ATOMA_PREVIEW_IMAGE=
ATOMA_GATEWAY_IMAGE=
ATOMA_PUBLIC_HOST=app.example.com
ATOMA_PREVIEW_DOMAIN=previews.example.com
ATOMA_WEB_ENV_FILE=/srv/atoma/config/web.env
ATOMA_EGRESS_ALLOWLIST=registry.npmjs.org,pypi.org,files.pythonhosted.org
