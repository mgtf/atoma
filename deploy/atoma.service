[Unit]
Description=Atoma control plane and visualizer
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/home/atoma

[Service]
Type=simple
User=atoma
Group=atoma
WorkingDirectory=/home/atoma/current
EnvironmentFile=/home/atoma/config/atoma.env
ExecStart=/usr/bin/node /home/atoma/current/dist/viz/server.js --host 127.0.0.1 --port 4111
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
