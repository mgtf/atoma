{
  "name": "atoma",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://atoma.run",
  "type": "module",
  "description": "Three-tier LLM agent orchestration with persisted types, earned trust, and symmetric supervision",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run viz:build",
    "build:worker": "docker build -f docker/worker.Dockerfile -t atoma-worker:latest .",
    "build:worker:dev": "npm run build && npm run build:worker",
    "build:preview": "docker build -f docker/preview.Dockerfile -t atoma-preview:latest .",
    "preview:demo": "tsx scripts/preview-demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.all.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run docs:check && npm run typecheck && npm run lint && npm test",
    "docs:check": "node scripts/check-agent-docs.mjs && node scripts/readme-facts.mjs && node scripts/architecture-ir.mjs",
    "docs:facts": "node scripts/readme-facts.mjs",
    "docs:architecture": "node scripts/architecture-ir.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node dist/cli/doctor.js",
    "doctor:dev": "tsx src/cli/doctor.ts",
    "deploy:preflight": "node dist/cli/deploy-preflight.js",
    "auth": "node dist/cli/auth.js",
    "auth:dev": "tsx src/cli/auth.ts",
    "projects": "node dist/cli/projects.js",
    "projects:dev": "tsx src/cli/projects.ts",
    "sentinel": "node dist/cli/sentinel.js",
    "sentinel:dev": "tsx src/cli/sentinel.ts",
    "analyst": "node dist/cli/analyst.js",
    "analyst:dev": "tsx src/cli/analyst.ts",
    "mender": "node dist/cli/mender.js",
    "mender:dev": "tsx src/cli/mender.ts",
    "release:check": "npm run check && npm audit && npm run build && node scripts/release-smoke.mjs && node scripts/auth-release-smoke.mjs && npm run auth -- --help && npm run doctor -- --help && npm run analyst -- --help && npm run mender -- --help",
    "release:container-smoke": "node scripts/release-container-smoke.mjs",
    "run:build": "node dist/cli/build-app.js",
    "run:build:dev": "tsx src/cli/build-app.ts",
    "registry": "tsx src/cli/registry.ts",
    "burnin": "tsx src/cli/burnin.ts",
    "curriculum": "tsx src/cli/curriculum.ts",
    "skills": "tsx src/cli/skills.ts",
    "viz": "node --import tsx scripts/viz-dev.mjs",
    "viz:dev": "node --import tsx scripts/viz-dev.mjs",
    "viz:gpu": "node --import tsx scripts/viz-dev.mjs --ui gpu",
    "viz:mui": "node --import tsx scripts/viz-dev.mjs --ui mui",
    "viz:build": "node scripts/viz-build.mjs gpu",
    "viz:build:mui": "node scripts/viz-build.mjs mui",
    "viz:shot": "node scripts/viz-screenshot.mjs",
    "viz:smoke": "npm run build && node scripts/viz-gpu-smoke.mjs",
    "viz:smoke:gc": "node scripts/viz-gpu-gc-smoke.mjs",
    "viz:mark-turn": "node scripts/viz-mark-turn.mjs",
    "viz:mark-turn:analyze": "python3 scripts/viz-mark-turn-analyze.py",
    "viz:frame-probe": "node scripts/viz-frame-probe.mjs",
    "viz:serve": "node dist/viz/server.js",
    "viz:demo": "tsx src/viz/demo.ts",
    "ledger": "tsx src/cli/ledger.ts",
    "friction": "tsx src/cli/friction.ts",
    "backup": "tsx src/cli/backup.ts",
    "benchmark": "tsx src/cli/benchmark.ts",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:translate": "node scripts/i18n.mjs translate",
    "prepare": "node scripts/husky-install.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "13.0.3",
    "i18next": "^25.10.10",
    "jsonrepair": "^3.14.0",
    "puppeteer": "^25.6.0",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    },
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@headlessui/react": "^2.2.10",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
