{
  "name": "atoma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three-tier LLM agent framework with persisted atom/molecule/cell taxonomy and symmetric supervision",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/viz/ui.html dist/viz/ui.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:research": "tsx src/examples/research-brief.ts",
    "example:build": "tsx src/examples/build-app.ts",
    "registry": "tsx src/cli/registry.ts",
    "skills": "tsx src/cli/skills.ts",
    "viz": "tsx src/viz/server.ts",
    "viz:demo": "tsx src/viz/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.3.0",
    "jsonrepair": "^3.14.0",
    "puppeteer": "^24.41.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
