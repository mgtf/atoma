# ── LLM provider ────────────────────────────────────────────────────────────
# anthropic (default, needs ANTHROPIC_API_KEY) | claude-cli (Claude Code
# subscription, no key) | ollama (local / Ollama Cloud)
ATOMA_LLM=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ── Per-tier models (PROVIDER-AGNOSTIC) ─────────────────────────────────────
# The unit of configuration is the TIER — decreasing model power L3→L1 is the
# whole thesis. Values are whatever the active provider serves; defaults are
# the Anthropic pins. A `provider:` prefix routes JUST that tier to another
# vendor (known prefixes: zai, anthropic, ollama, claude-cli). Examples:
#   claude-cli, no Opus on this plan:   ATOMA_MODEL_L3=sonnet   (L1/L2 intact)
#   local Ollama three-tier gradient:   L1=qwen3:4b L2=qwen3:14b L3=qwen3:32b
#   CROSS-VENDOR gradient — cheap L1 on Z.ai, the rest untouched:
#     ATOMA_MODEL_L1=zai:glm-4.5-air
# ATOMA_MODEL_L1=claude-haiku-4-5-20251001
# ATOMA_MODEL_L2=claude-sonnet-5
# ATOMA_MODEL_L3=claude-opus-5

# Z.ai (referenced by `zai:` tier pins) — Anthropic-compatible endpoint, so
# the standard client serves it. Pick any GLM model id from Z.ai's lineup.
# ZAI_API_KEY=zai-...
# ZAI_BASE_URL=https://api.z.ai/api/anthropic

# Out-of-band post-mortem analyst (scripts/analyst-watch.mjs). These scoped
# variables reroute only its read-only child session, never atoma's run
# transport. The source watcher fills unset values from checkout `.env`;
# deployed units should inject the same names directly.
# ATOMA_ANALYST_MODEL=glm-5.3
# ATOMA_ANALYST_BASE_URL=https://api.z.ai/api/anthropic
# ATOMA_ANALYST_AUTH_TOKEN=zai-...

# Debug ONLY (claude-cli): collapse ALL tiers onto one model. Breaks the cost
# gradient — never use in normal operation.
# ATOMA_CLAUDE_MODEL=sonnet

# ollama only:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=glm-5.1:cloud

# ── Storage & workspaces ────────────────────────────────────────────────────
# ONE store for every task family: atom types, their version history and the
# lifecycle ledger (table `lifecycle_events`). ATOMA_BUILD_DB_PATH is retired —
# still read as a migration ramp, no longer a second store.
# ATOMA_DB_PATH=./atoma.db                  # atom registry + lifecycle ledger
# ATOMA_LEDGER_DB=./atoma.db                # ledger only, if it must differ (tests do this)
# ATOMA_BUILD_WORKSPACE=~/.atoma/workspaces/build   # sandboxed deliverable workspace
# ATOMA_SKILLS_DIR=./skills                 # learned-skill store (filesystem)
# ATOMA_PROJECTS_ROOT=~/.atoma              # orgs/<orgId>/projects/<projectId>/runs/<runId>
# ATOMA_PREFILTER_CACHE=0                   # '0' disables; any other value = a DB path
#                                           # (default: the one store, table prefilter_cache)
# ATOMA_RUNS_DIR=./runs                     # where runs write their traces; the
#                                           # viz server and the sentinel read it
# ATOMA_BURNIN_CSV=./burnin/results.csv     # burn-in ledger (viz Burn-in tab)

# ── Optional visualizer authentication (single organisation) ───────────────
# Disabled by default. Node never loads this file by itself. `npm run viz`,
# `npm run doctor:dev` and `npm run auth:dev` fill unset keys from checkout
# `.env`; compiled `npm run viz:serve` still reads only the process environment.
# When enabled, the public origin is the one exact origin registered at each
# provider with callback `${origin}/auth/callback`.
#
# Local GitHub-gated visualizer (`npm run viz` proxies /auth to the API):
# ATOMA_VIZ_AUTH=1
# ATOMA_VIZ_PUBLIC_ORIGIN=http://127.0.0.1:5173
#
# Dedicated deployment:
# ATOMA_VIZ_AUTH=1
# ATOMA_VIZ_PUBLIC_ORIGIN=https://atoma.example.com
# X-Forwarded-For is ignored unless the direct proxy's exact IP is allowlisted.
# ATOMA_VIZ_TRUSTED_PROXIES=127.0.0.1,::1

# ── The mechanical watch, hosted by the gated visualizer ───────────────────
# A gated viz server arms the sentinel in-process: zero tokens, read-only over
# runs in flight, journal rows only, no power over any run. Armed by default;
# a value that is not 0/false/1/true warns and keeps watching, because a typo
# must not cost you the visualizer. `npm run sentinel` is the watch for an
# ungated checkout, another machine, or a burn-in batch that owns the machine.
# ATOMA_VIZ_SENTINEL=0                      # this server does not watch
# ATOMA_VIZ_SENTINEL_INTERVAL_MS=20000      # poll cadence (minimum 1000)
# ATOMA_SENTINEL_COST_ALERT_USD=2.50        # arm the cost rule (an alert, not a budget)

# Configure at least one login provider. These credentials identify people;
# they never grant model inference or charge a user's provider subscription.
# ATOMA_AUTH_GITHUB_CLIENT_ID=...
# ATOMA_AUTH_GITHUB_CLIENT_SECRET=...
# ATOMA_AUTH_GOOGLE_CLIENT_ID=...
# ATOMA_AUTH_GOOGLE_CLIENT_SECRET=...
# ATOMA_AUTH_CHATGPT_CLIENT_ID=...
# ATOMA_AUTH_CHATGPT_CLIENT_SECRET=...       # optional when the approved client uses PKCE without client auth

# ChatGPT login requires an approved client. Its defaults follow the provider's
# official discovery metadata; all providers also accept endpoint overrides for
# controlled deployments and tests:
# ATOMA_AUTH_<PROVIDER>_AUTHORIZE_URL=https://...
# ATOMA_AUTH_<PROVIDER>_TOKEN_URL=https://...
# ATOMA_AUTH_<PROVIDER>_USERINFO_URL=https://...
# Legacy unprefixed *_CLIENT_ID / *_CLIENT_SECRET names remain compatibility
# inputs only; use the ATOMA_AUTH_* names for every new deployment.
#
# ── Optional GitHub App (organisation install + artifact publish) ───────────
# Requires the visualizer auth gate AND a GitHub login client (the App's OAuth
# credentials are the same ATOMA_AUTH_GITHUB_* pair). Register:
#   Callback URL  ${ATOMA_VIZ_PUBLIC_ORIGIN}/auth/callback
#   Setup URL     ${ATOMA_VIZ_PUBLIC_ORIGIN}/auth/github/setup
#   Webhook URL   ${ATOMA_VIZ_PUBLIC_ORIGIN}/webhooks/github
# ATOMA_GITHUB_APP_ID=123456
# ATOMA_GITHUB_APP_SLUG=atoma
# ATOMA_GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# # or ATOMA_GITHUB_APP_PRIVATE_KEY_PATH=/operator/github-app.pem
# ATOMA_GITHUB_WEBHOOK_SECRET=...          # at least 32 bytes
# ATOMA_GITHUB_TOKEN_ENCRYPTION_KEY=...    # 32 bytes as 64 hex chars or unpadded base64url
# # ATOMA_GITHUB_TOKEN_ENCRYPTION_KEY_ID=ops-2026-08
# # ATOMA_GITHUB_API_URL=https://api.github.com

# ── Run budget ──────────────────────────────────────────────────────────────
# Default: 600s (900s under claude-cli — subprocess overhead per call).
# ATOMA_BUILD_TIMEOUT_MS=900000

# ── Lifecycle thresholds (defaults shown; invalid values fall back, never
#    to a weaker gate) ─────────────────────────────────────────────────────
# ATOMA_TRUST_THRESHOLD=3     # clean successes before validators are skipped
# ATOMA_PROMOTE_THRESHOLD=3   # clean successes before llm→script compilation
# ATOMA_DEMOTE_AFTER=2        # deterministic failures before script demotion

# ── Skill lifecycle toggles (all ON by default in the build example) ────────
# ATOMA_SKILL_LEARN=0      # disable auto-distillation of new skills
# ATOMA_SKILL_PROMOTE=0    # disable llm→script compilation at 3✓/0✗
# ATOMA_SKILL_DIRECT=0     # disable zero-LLM dispatch of trusted scripts
