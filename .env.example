# ── Per-tier models — ALL THREE REQUIRED, no default ────────────────────────
# The unit of configuration is the TIER — decreasing model power L3→L1 is the
# whole thesis. Each tier names its model in full:
#
#   <mode>:<vendor>:<model>
#
#   mode    api  the vendor's API, billed to a key (Ollama: your own hardware)
#           sub  THIS machine's subscription through the vendor's CLI:
#                Claude Code for anthropic (`claude /login`), Codex for openai
#                (`codex login`). L1 cannot use sub:openai (Codex has no tool loop).
#           own  a member's personal login — Settings only, never in this file
#   vendor  anthropic | openai | zai | ollama
#
# There is no ATOMA_LLM and no built-in default: a tier left unset is a
# launch error naming the variable. Examples:
#   All three tiers on your Claude subscription, no key:
#     ATOMA_MODEL_L1=sub:anthropic:haiku
#     ATOMA_MODEL_L2=sub:anthropic:sonnet
#     ATOMA_MODEL_L3=sub:anthropic:opus       (no Opus on this plan? sub:anthropic:sonnet)
#   Local Ollama gradient:  api:ollama:qwen3:4b / api:ollama:qwen3:14b / api:ollama:qwen3:32b
#   Cheap L1 on Z.ai by key, ChatGPT supervisors through Codex:
#     ATOMA_MODEL_L1=api:zai:glm-4.5-air
#     ATOMA_MODEL_L2=sub:openai:gpt-5.4-mini
#     ATOMA_MODEL_L3=sub:openai:gpt-5.6-sol
ATOMA_MODEL_L1=api:anthropic:claude-haiku-4-5-20251001
ATOMA_MODEL_L2=api:anthropic:claude-sonnet-5
ATOMA_MODEL_L3=api:anthropic:claude-opus-5

# Credentials, one per `api:` vendor a tier names. Only referenced vendors
# are constructed, so a missing key matters only if a tier asks for it.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...                      # api:openai (Responses API, tools on every tier)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ZAI_API_KEY=zai-...                        # api:zai — Anthropic-compatible endpoint
# ZAI_BASE_URL=https://api.z.ai/api/anthropic

# Hosted project runs: a `sub:` tier is never taken from this file — it is a
# platform admin's own account pin in Settings, honoured only in the ONE
# organisation declared here.
# ATOMA_HOST_SUBSCRIPTION_ORG=<organisation-id>

# Post-mortem analyst (npm run analyst, src/supervisor). ONE selector, the
# same grammar as the tiers, REQUIRED once the analyst is enabled and with no
# default. The credential it needs is read from the shared variables above
# and forwarded to its read-only child session only, never to atoma's runs.
#   sub:anthropic:sonnet      Claude Code on this machine's login
#   api:zai:glm-5.3           Claude Code pointed at Z.ai (ZAI_API_KEY, ZAI_BASE_URL)
#   api:anthropic:claude-sonnet-5   Claude Code with ANTHROPIC_API_KEY
#   sub:openai:gpt-5.6-sol    Codex on a ChatGPT login (api:openai is refused)
# ATOMA_ANALYST_MODEL=sub:openai:gpt-5.6-sol
# ATOMA_ANALYST_CODEX_HOME=/home/atoma/.codex
# ATOMA_SUPERVISOR_CMD_CODEX=/home/atoma/.local/bin/codex

# Mender (npm run mender, src/supervisor): turns a verdict's cited `defect`
# into a pull request against main. Its own selector, else the analyst's —
# whole, never a mix. A person merges: there is no auto-merge path.
# ATOMA_MENDER_MODEL=sub:openai:gpt-5.6-sol
# ATOMA_MENDER_CODEX_HOME=/path/to/dedicated-chatgpt-login
# ATOMA_MENDER_CMD_CODEX=codex
# Codex uses subscription auth only. USD ceilings apply only to Claude;
# Codex retains wall-clock bounds and records unreported cost as null.

# Resident analyst inside the gated viz server (production shape). OPT-IN: it
# spends the selected provider's quota and needs its CLI on the host.
# The separate VPS mender service reads persistent verdicts and reserves the
# same run slot. Its dedicated environment is deploy/mender.env.example;
# setup and GitHub cleanup: docs/supervisor-codex-production.md.
# ATOMA_VIZ_ANALYST=1
# ATOMA_ANALYST_QUIET_MS=120000             # a finished run waits this long before analysis
# ATOMA_ANALYST_BUDGET_USD=2                # spend ceiling per analysis
# ATOMA_SUPERVISOR_DIR=/home/atoma/state/supervisor

# Debug ONLY (sub:anthropic tiers): collapse ALL Claude CLI tiers onto one
# model. Breaks the cost gradient — never use in normal operation.
# ATOMA_CLAUDE_MODEL=sonnet

# ollama only:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=glm-5.1:cloud

# ── Required project search — local Haystack on the host ───────────────────
# Required for every project run; this configures the engine, not activation.
# Provision Python with scripts/requirements-haystack.txt, then generate the
# JSON and runtime fingerprint: docs/project-retrieval-haystack-only-2026-09-09.md
# Generator: npm run --silent haystack:config:dev -- --python /absolute/venv/bin/python
# Hybrid: also supply --embedding /models/embedding --reranker /models/reranker
# and --query-prefix '<prefix required by the embedding model>'. Use
# haystack:config in a compiled deployment; doctor verifies configured pins.
# Paste the generated JSON as a single quoted line. Replace BOTH placeholders;
# runtimeSha256 is the installed Python/package identity, not a model hash.
# BM25 runs through Haystack without model weights or a paid retrieval API.
# ATOMA_HAYSTACK_CONFIG='{"python":"/absolute/venv/bin/python","settings":{"mode":"bm25"},"runtimeSha256":"<generated-sha256>"}'
# For embeddings + reranking, use mode hybrid-rerank with provisioned local
# model paths and content fingerprints, as documented in the same guide.
# Compiled services need this variable in their process environment; they do
# not automatically load .env. Restart the coordinator after changing it.

# ── Storage & workspaces ────────────────────────────────────────────────────
# ONE store for every task family: atom types, their version history and the
# lifecycle ledger (table `lifecycle_events`). ATOMA_BUILD_DB_PATH is retired —
# still read as a migration ramp, no longer a second store.
# ATOMA_DB_PATH=./atoma.db                  # atom registry + lifecycle ledger
# ATOMA_LEDGER_DB=./atoma.db                # ledger only, if it must differ (tests do this)
# ATOMA_BUILD_WORKSPACE=~/.atoma/workspaces/build   # sandboxed deliverable workspace
# ATOMA_SKILLS_DIR=./skills                 # learned-skill store (filesystem)
# ATOMA_PROJECTS_ROOT=~/.atoma              # orgs/<orgId>/projects/<projectId>/runs/<runId>
# ATOMA_ACCOUNT_PROFILES_ROOT=~/.atoma/account-profiles # private per-principal Codex credentials
# ATOMA_PREFILTER_CACHE=0                   # '0' disables; any other value = a DB path
#                                           # (default: the one store, table prefilter_cache)
# ATOMA_RUNS_DIR=./runs                     # where runs write their traces; the
#                                           # viz server and the sentinel read it
# ATOMA_BURNIN_CSV=./burnin/results.csv     # burn-in ledger (viz Burn-in tab)
# Host-owned deployment drain marker. When present, the compiled viz keeps
# reads available but answers 503 to new writes/runs/previews. The automatic
# deployment wrapper creates and removes it; use an absolute state path.
# ATOMA_DEPLOY_LOCK_PATH=/home/atoma/state/deploy.lock

# ── Optional visualizer authentication (single organisation) ───────────────
# Disabled by default. Node never loads this file by itself. `npm run viz`,
# `npm run doctor:dev` and `npm run auth:dev` fill unset keys from checkout
# `.env`; compiled `npm run viz:serve` still reads only the process environment.
# When enabled, the public origin is the one exact origin registered at each
# provider with callback `${origin}/auth/callback`.
#
# Local GitHub-gated visualizer (`npm run viz` proxies /auth to the API):
# ATOMA_VIZ_AUTH=1
# ATOMA_VIZ_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Register Atoma's service worker during development to test PWA caching and
# browser push (push still needs its own server configuration and permission).
# Off by default in dev; production builds register it automatically.
# Restart npm run viz and reload the page after changing this value. When off,
# the client unregisters Atoma's worker and removes its atoma-viz-* caches.
# ATOMA_VIZ_SW_DEV=1
#
# Dedicated deployment:
# ATOMA_VIZ_AUTH=1
# ATOMA_VIZ_PUBLIC_ORIGIN=https://atoma.run
# X-Forwarded-For is ignored unless the direct proxy's exact IP is allowlisted.
# ATOMA_VIZ_TRUSTED_PROXIES=127.0.0.1,::1

# ── The mechanical watch, hosted by the gated visualizer ───────────────────
# A gated viz server arms the sentinel in-process: zero tokens, read-only over
# runs in flight, journal rows only, no power over any run. Armed by default;
# a value that is not 0/false/1/true warns and keeps watching, because a typo
# must not cost you the visualizer. `npm run sentinel` is the watch for an
# ungated checkout, another machine, or a burn-in batch that owns the machine.
# ATOMA_VIZ_SENTINEL=0                      # this server does not watch
# ATOMA_VIZ_SENTINEL_INTERVAL_MS=20000      # poll cadence (minimum 1000)
# ATOMA_SENTINEL_COST_ALERT_USD=2.50        # arm the cost rule (an alert, not a budget)

# Configure at least one login provider. These credentials identify people;
# they never grant model inference or charge a user's provider subscription.
# ATOMA_AUTH_GITHUB_CLIENT_ID=...
# ATOMA_AUTH_GITHUB_CLIENT_SECRET=...
# ATOMA_AUTH_GOOGLE_CLIENT_ID=...
# ATOMA_AUTH_GOOGLE_CLIENT_SECRET=...
# ATOMA_AUTH_CHATGPT_CLIENT_ID=...
# ATOMA_AUTH_CHATGPT_CLIENT_SECRET=...       # optional when the approved client uses PKCE without client auth

# ChatGPT login requires an approved client. Its defaults follow the provider's
# official discovery metadata; all providers also accept endpoint overrides for
# controlled deployments and tests:
# ATOMA_AUTH_<PROVIDER>_AUTHORIZE_URL=https://...
# ATOMA_AUTH_<PROVIDER>_TOKEN_URL=https://...
# ATOMA_AUTH_<PROVIDER>_USERINFO_URL=https://...
# Legacy unprefixed *_CLIENT_ID / *_CLIENT_SECRET names remain compatibility
# inputs only; use the ATOMA_AUTH_* names for every new deployment.
#
# ── Optional GitHub App (organisation install + artifact publish) ───────────
# FULL PROCEDURE, permissions, events and troubleshooting:
#   docs/github-app-setup.md
# Requires the visualizer auth gate AND a GitHub login client (the App's OAuth
# credentials are the same ATOMA_AUTH_GITHUB_* pair). Register:
#   Callback URL  ${ATOMA_VIZ_PUBLIC_ORIGIN}/auth/callback
#   Setup URL     ${ATOMA_VIZ_PUBLIC_ORIGIN}/auth/github/setup
#   Webhook URL   ${ATOMA_VIZ_PUBLIC_ORIGIN}/webhooks/github
# ATOMA_GITHUB_APP_ID=123456
# ATOMA_GITHUB_APP_SLUG=atoma
# ATOMA_GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# # or ATOMA_GITHUB_APP_PRIVATE_KEY_PATH=/operator/github-app.pem
# ATOMA_GITHUB_WEBHOOK_SECRET=...          # at least 32 bytes
# ATOMA_GITHUB_TOKEN_ENCRYPTION_KEY=...    # 32 bytes as 64 hex chars or unpadded base64url
# # ATOMA_GITHUB_TOKEN_ENCRYPTION_KEY_ID=ops-2026-08
# # ATOMA_GITHUB_API_URL=https://api.github.com
#
# ── Optional result preview (watch the app a run produced) ─────────────────
# A preview runs MODEL-AUTHORED CODE on your hardware, in a browser you invited
# people into. Every precondition below is required together — there is no
# partial mode, and half a configuration is a hard failure rather than a silent
# "disabled". Check a host with:
#   npm run doctor -- --preview
# It starts one real container and asks the ENGINE what runtime ran it, then
# proves the root filesystem refuses a write and a network-less container
# cannot resolve a name. A passing result is those refusals.
#
# Requires: the auth gate on (a preview belongs to an organisation's run), an
# HTTPS public origin (the grant cookie is __Host- and Secure; a browser stores
# neither over http, so previews would 404 with nothing in the logs), Docker
# Engine 28+, gVisor REGISTERED with the engine (`runsc install` and a daemon
# restart — Docker Desktop cannot do this; use a Linux host or VM), and the
# preview image already pulled: a member's click is not the moment to go to a
# registry.
#
# Use a dedicated namespace, e.g. previews.atoma.run for app atoma.run.
# It must not contain the app host. Wildcard DNS and TLS: one host per preview
# GENERATION, so a restart is a new origin and a previous generation's service
# workers, storage and caches cannot reach the next.
# ATOMA_PREVIEW=1
# ATOMA_PREVIEW_DOMAIN=previews.atoma.run         # *.previews.atoma.run
# ATOMA_PREVIEW_IMAGE=atoma-preview@sha256:...    # pinned by digest; a tag is not an identity
# ATOMA_PREVIEW_GATEWAY_HOST=127.0.0.1
# ATOMA_PREVIEW_GATEWAY_PORT=4311
# ATOMA_PREVIEW_RUNTIME=runsc                     # production requires gVisor
# ATOMA_PREVIEW_MAX_GLOBAL=4
# ATOMA_PREVIEW_MAX_PER_ORG=2                     # never above MAX_GLOBAL
# ATOMA_PREVIEW_IDLE_MS=900000                    # must be shorter than HARD_MS
# ATOMA_PREVIEW_HARD_MS=7200000
# ATOMA_PREVIEW_COPY_MAX_BYTES=536870912
#
# THE TWO LOUD DEVELOPMENT ESCAPE HATCHES. Neither is ever derived: each is
# asked for by name, and each refuses to resolve rather than falling back.
# `npm run preview:demo` prints a block that uses both.
#
# runc, for an engine that cannot register gVisor (Docker Desktop cannot). It
# boots behind the auth gate ONLY when the visualizer origin and the gateway
# bind are both loopback — a machine nobody else can log in to has no tenants
# to hand a weaker sandbox.
# ATOMA_PREVIEW_RUNTIME=runc
# ATOMA_PREVIEW_ALLOW_RUNC_DEV=1
#
# Cleartext previews, which remove the proxy, the wildcard certificate and the
# wildcard DNS entirely. Browsers resolve *.localhost to loopback themselves
# and treat it as a SECURE CONTEXT, so the grant cookie keeps every attribute
# it has in production and is still stored inside the frame. The claim and the
# grant do travel in the clear on this machine, which is why all four hold or
# it throws: the flag, a .localhost domain, a loopback visualizer origin that
# is PRESENT, and a loopback gateway bind.
# ATOMA_PREVIEW_DOMAIN=previews.localhost
# ATOMA_PREVIEW_ALLOW_HTTP_DEV=1

# ── Organisation BYO provider keys (Settings) ──────────────────────────────
# Wraps Anthropic/Z.ai keys stored for an organisation. 32 bytes as 64 hex
# chars, unpadded base64url, or a passphrase of at least 32 characters.
# If unset, a gated checkout reuses ATOMA_GITHUB_TOKEN_ENCRYPTION_KEY.
# The passphrase form is a plain SHA-256 of the text, with no stretching: it
# exists so a small deployment is not pushed into inventing a weak "random"
# string, and it is only as strong as the passphrase itself. Anyone holding a
# copy of the SQLite file can run a dictionary against a memorable one, and
# that unwraps every organisation's provider keys at once. Prefer the hex or
# base64url form (`openssl rand -hex 32`) wherever the file can be copied —
# backups, a shared host, a container image. THE PASSPHRASE FORM IS ACCEPTED
# FOR THIS VARIABLE ONLY: ATOMA_GITHUB_TOKEN_ENCRYPTION_KEY above takes the
# strict form alone (64 hex characters, or 43 canonical base64url), and a
# passphrase there is refused at launch.
# ATOMA_SECRET_ENCRYPTION_KEY=...
# # ATOMA_SECRET_ENCRYPTION_KEY_ID=ops-2026-08

# ── Run budget ──────────────────────────────────────────────────────────────
# Default: 600s (900s when a tier rides the Claude CLI — subprocess overhead per call).
# ATOMA_BUILD_TIMEOUT_MS=900000

# ── Lifecycle thresholds (defaults shown; invalid values fall back, never
#    to a weaker gate) ─────────────────────────────────────────────────────
# ATOMA_TRUST_THRESHOLD=3     # clean successes before validators are skipped
# ATOMA_PROMOTE_THRESHOLD=3   # clean successes before llm→script compilation
# ATOMA_DEMOTE_AFTER=2        # deterministic failures before script demotion

# ── Skill lifecycle toggles (all ON by default in the build example) ────────
# ATOMA_SKILL_LEARN=0      # disable auto-distillation of new skills
# ATOMA_SKILL_PROMOTE=0    # disable llm→script compilation at 3✓/0✗
# ATOMA_SKILL_DIRECT=0     # disable zero-LLM dispatch of trusted scripts
